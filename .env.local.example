# Supabase — create a project at https://supabase.com
# Run supabase/migrations/001_initial.sql in the SQL Editor
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenWeatherMap — https://home.openweathermap.org/api_keys
# Free tier: current + 5-day/3-hour forecast. One Call 3.0 needs a separate subscription.
# Keep this server-only (do not use NEXT_PUBLIC_). New keys can take up to 2 hours to activate.
OPENWEATHERMAP_KEY=your-openweathermap-key

# Optional fallback while an OpenWeatherMap key activates
# WEATHERAPI_KEY=your-weatherapi-key
